[7.808138, "o", "\u001b[38;5;242m#\u001b[0m\u001b[38;5;242m yaml-language-server: $schema=https://raw.githubusercontent.com/asamarts/alint/main/schemas/v1/config.json\u001b[0m\r\n\u001b[38;5;242m#\u001b[0m\r\n\u001b[38;5;242m#\u001b[0m\u001b[38;5;242m Polyglot demo project. One config covers the structural hygiene of\u001b[0m\r\n\u001b[38;5;242m#\u001b[0m\u001b[38;5;242m a tiny Rust + Node + Python tree plus a hardened CI workflow.\u001b[0m\r\n\r\n\u001b[38;5;203mversion\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;141m1\u001b[0m\r\n\r\n\u001b[38;5;203mextends\u001b[0m\u001b[38;5;231m:\u001b[0m\r\n\u001b[38;5;231m  \u001b[0m\u001b[38;5;231m-\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186malint://bundled/oss-baseline@v1\u001b[0m\r\n\u001b[38;5;231m  \u001b[0m\u001b[38;5;231m-\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186malint://bundled/rust@v1\u001b[0m\r\n\u001b[38;5;231m  \u001b[0m\u001b[38;5;231m-\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186malint://bundled/node@v1\u001b[0m\r\n\u001b[38;5;231m  \u001b[0m\u001b[38;5;231m-\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186malint://bundled/python@v1\u001b[0m\r\n\u001b[38;5;231m  \u001b[0m\u001b[38;5;231m-\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186malint://bundled/ci/github-actions@v1\u001b[0m\r\n\r\n\u001b[38;5;203mrules\u001b[0m\u001b[38;5;231m:\u001b[0m\r\n\u001b[38;5;231m  \u001b[0m\u001b[38;5;231m-\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;203mid\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186msrc-todos-need-issue-refs\u001b[0m\r\n\u001b[38;5;231m    \u001b[0m\u001b[38;5;203mkind\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186mfile_content_forbidden\u001b[0m\r\n\u001b[38;5;231m    \u001b[0m\u001b[38;5;203mpaths\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186m\"\u001b[0m\u001b[38;5;186m**/src/**/*.{js,ts,py,rs}\u001b[0m\u001b[38;5;186m\"\u001b[0m\r\n\u001b[38;5;231m    \u001b[0m\u001b[38;5;203mpattern\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186m'\u001b[0m\u001b[38;5;186mTODO[^(]\u001b[0m\u001b[38;5;186m'\u001b[0m\r\n\u001b[38;5;231m    \u001b[0m\u001b[38;5;203mlevel\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186mwarning\u001b[0m\r\n\u001b[38;5;231m    \u001b[0m\u001b[38;5;203mmessage\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;186m\"\u001b[0m\u001b[38;5;186mTODO needs an issue ref: TODO(#123).\u001b[0m\u001b[38;5;186m\"\u001b[0m\r\n"]
