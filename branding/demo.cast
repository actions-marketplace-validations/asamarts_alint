[12.769042, "o", "\u001b[1m\u001b[33mwarning\u001b[0m  oss-readme-exists  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://opensource.guide/starting-a-project/#writing-a-readme\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  oss-license-exists  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://opensource.guide/legal/#which-open-source-license-is-appropriate-for-my-project\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-license-non-empty\r\n\u001b[36minfo\u001b[0m     oss-readme-non-stub\r\n\u001b[36minfo\u001b[0m     oss-security-policy-exists  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://docs.github.com/en/code-security/getting-started/adding-a-security-policy-to-your-repository\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-security-policy-non-empty  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://github.com/ossf/scorecard/blob/main/docs/checks.md#security-policy\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-dependency-update-tool  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://github.com/ossf/scorecard/blob/main/docs/checks.md#dependency-update-tool\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-codeowners-exists  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://github.com/ossf/scorecard/blob/main/docs/checks.md#code-review\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-codeowners-non-empty\r\n\u001b[36minfo\u001b[0m     oss-code-of-conduct-exists  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://www.contributor-covenant.org/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-gitignore-exists\r\n\u001b[1m\u001b[31merror\u001b[0m    oss-no-merge-conflict-markers\r\n\u001b[1m\u001b[31merror\u001b[0m    oss-no-bidi-controls  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://trojansource.codes/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     oss-final-newline\r\n\u001b[36minfo\u001b[0m     oss-no-trailing-whitespace\r\n\u001b[1m\u001b[31merror\u001b[0m    rust-cargo-toml-exists \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  rust-cargo-lock-exists \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     rust-toolchain-pinned \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    rust-no-tracked-target \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    rust-sources-snake-case \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  rust-sources-final-newline \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     rust-sources-no-trailing-whitespace \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    rust-sources-no-bidi \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://trojansource.codes/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    rust-sources-no-zero-width \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    rust-no-merge-markers-in-manifests \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    node-package-json-exists \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  node-has-lockfile \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://docs.npmjs.com/cli/v10/configuring-npm/package-lock-json\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    node-no-tracked-node-modules \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     node-no-tracked-dist \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     node-engine-or-nvmrc \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     node-sources-final-newline \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     node-sources-no-trailing-whitespace \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    node-sources-no-bidi \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://trojansource.codes/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    python-manifest-exists \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://packaging.python.org/en/latest/guides/writing-pyproject-toml/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  python-has-lockfile \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  python-pyproject-declares-name \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://peps.python.org/pep-0621/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     python-pyproject-declares-requires-python \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     python-module-snake-case \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://peps.python.org/pep-0008/#package-and-module-names\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     python-sources-final-newline \u001b[2m[when]\u001b[0m\r\n\u001b[36minfo\u001b[0m     python-sources-no-trailing-whitespace \u001b[2m[when]\u001b[0m\r\n\u001b[1m\u001b[31merror\u001b[0m    python-sources-no-bidi \u001b[2m[when]\u001b[0m  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://trojansource.codes/\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  gha-workflow-contents-read  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://docs.github.com/en/actions/security-guides/automatic-token-authentication#permissions-for-the-github_token\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[1m\u001b[33mwarning\u001b[0m  gha-pin-actions-to-sha  \u001b[2m(\u001b[0m\u001b[4m\u001b[34mhttps://docs.github.com/en/actions/security-guides/security-hardening-for-github-actions#using-third-party-actions\u001b[0m\u001b[2m)\u001b[0m\r\n\u001b[36minfo\u001b[0m     gha-workflow-has-name\r\n\u001b[1m\u001b[33mwarning\u001b[0m  src-todos-need-issue-refs\r\n"]
