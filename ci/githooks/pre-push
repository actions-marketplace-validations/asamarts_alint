#!/usr/bin/env bash
# Git pre-push hook — runs ci/scripts/preflight.sh (fmt + clippy +
# test + doc + dogfood) before letting the push reach origin.
#
# Install:
#   git config core.hooksPath ci/githooks
#
# Skip for one push (e.g. a WIP branch):
#   git push --no-verify
#
# Skip a specific check inside the bundle (debugging a flaky one):
#   PREFLIGHT_SKIP=test git push

set -euo pipefail

# git pre-push passes one line per ref being pushed on stdin, in
# the form: <local-ref> <local-sha> <remote-ref> <remote-sha>.
# A delete (push :branch) has the all-zero SHA as local-sha; we
# don't need to lint a deletion. Branch creates / updates fall
# through to the preflight.
deletion_only=1
while read -r local_ref local_sha _remote_ref _remote_sha; do
  if [[ "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
    deletion_only=0
  fi
done

if [[ "$deletion_only" == "1" ]]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/ci/scripts/preflight.sh"
